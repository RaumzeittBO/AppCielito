rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == '4iftAGoQawabSz1EEpKufdPQccC2'
        && request.auth.uid == uid;
    }
    function boundedText(data, field, maxLength) {
      return data[field] is string && data[field].size() <= maxLength;
    }
    function validEntity(bucket, data) {
      return (bucket == 'products' && boundedText(data, 'name', 100)
          && data.price is number && data.price >= 0
          && data.cost is number && data.cost >= 0 && data.active is bool
          && data.get('imageId', '') is string && data.get('imageId', '').size() <= 100)
        || (bucket == 'customers' && boundedText(data, 'name', 120)
          && boundedText(data, 'phone', 40))
        || (bucket == 'orders' && boundedText(data, 'customer', 120)
          && data.date is string && data.time is string
          && data.items is list && data.items.size() > 0 && data.items.size() <= 30
          && data.total is number && data.total >= 0
          && data.paid is number && data.paid >= 0 && data.paid <= data.total
          && data.status in ['Pendiente', 'Entregado', 'Cancelado'])
        || ((bucket == 'expenses' || bucket == 'incomes')
          && data.amount is number && data.amount > 0
          && boundedText(data, 'category', 80) && data.date is string)
        || (bucket == 'incomeDeductions' && boundedText(data, 'incomeId', 180)
          && data.amount is number && data.amount > 0
          && boundedText(data, 'note', 180) && data.date is string
          && data.get('category', '') is string && data.get('category', '').size() <= 80
          && data.get('expenseId', '') is string && data.get('expenseId', '').size() <= 180)
        || (bucket == 'devices' && boundedText(data, 'token', 4096)
          && boundedText(data, 'platform', 512));
    }
    function validRecord(bucket, recordId) {
      let data = request.resource.data;
      return data.updatedAt is timestamp && (
        ((bucket == 'categories' || bucket == 'incomeCategories') && boundedText(data, 'name', 80))
        || (bucket == 'settings' && recordId == 'business'
          && boundedText(data, 'name', 120)
          && data.get('logoImageId', '') is string && data.get('logoImageId', '').size() <= 100)
        || (data.id == recordId && validEntity(bucket, data))
      );
    }
    match /users/{uid}/{bucket}/{recordId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validRecord(bucket, recordId);
      allow delete: if owner(uid) && bucket != 'reminders';
    }
    match /users/{uid}/reminders/{reminderId} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /users/{uid}/records/{recordId} {
      // Read-only compatibility path for one-time migration from the old local sync format.
      allow read: if owner(uid);
      allow write: if false;
    }
    match /users/{uid}/images/{imageId} {
      function validImage() {
        let data = request.resource.data;
        return data.keys().hasOnly(['id', 'kind', 'mimeType', 'bytes', 'size', 'width', 'height', 'updatedAt'])
          && data.id == imageId
          && data.kind in ['dish', 'logo']
          && data.mimeType in ['image/webp', 'image/jpeg']
          && data.bytes is bytes
          && data.bytes.size() > 0
          && data.bytes.size() <= 204800
          && data.size == data.bytes.size()
          && data.width is int && data.width > 0 && data.width <= 640
          && data.height is int && data.height > 0 && data.height <= 640
          && data.updatedAt is timestamp;
      }
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validImage();
      allow delete: if owner(uid);
    }
  }
}
