rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == '4iftAGoQawabSz1EEpKufdPQccC2'
        && request.auth.uid == uid;
    }
    function boundedText(data, field, maxLength) {
      return data[field] is string && data[field].size() <= maxLength;
    }
    function validRecord(bucket, recordId) {
      let data = request.resource.data;
      return data.id == recordId && data.updatedAt is timestamp && (
        (bucket == 'products' && boundedText(data, 'name', 100)
          && data.price is number && data.price >= 0
          && data.cost is number && data.cost >= 0 && data.active is bool)
        || (bucket == 'customers' && boundedText(data, 'name', 120)
          && boundedText(data, 'phone', 40))
        || (bucket == 'orders' && boundedText(data, 'customer', 120)
          && data.date is string && data.time is string
          && data.items is list && data.items.size() > 0 && data.items.size() <= 30
          && data.total is number && data.total >= 0
          && data.paid is number && data.paid >= 0 && data.paid <= data.total
          && data.status in ['Pendiente', 'Entregado', 'Cancelado'])
        || ((bucket == 'expenses' || bucket == 'incomes')
          && data.amount is number && data.amount > 0
          && boundedText(data, 'category', 80) && data.date is string)
        || (bucket == 'categories' && boundedText(data, 'name', 80))
        || (bucket == 'devices' && boundedText(data, 'token', 4096)
          && boundedText(data, 'platform', 512))
        || (bucket == 'settings' && recordId == 'business'
          && boundedText(data, 'name', 120))
      );
    }
    match /users/{uid}/{bucket}/{recordId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validRecord(bucket, recordId);
      allow delete: if owner(uid) && bucket != 'reminders';
    }
    match /users/{uid}/reminders/{reminderId} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /users/{uid}/records/{recordId} {
      // Read-only compatibility path for one-time migration from the old local sync format.
      allow read: if owner(uid);
      allow write: if false;
    }
  }
}
