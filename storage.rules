rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == "4iftAGoQawabSz1EEpKufdPQccC2" && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == "4iftAGoQawabSz1EEpKufdPQccC2" && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == "4iftAGoQawabSz1EEpKufdPQccC2" && request.auth.uid == uid;
    }
  }
}
